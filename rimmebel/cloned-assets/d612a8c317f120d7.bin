        <label class="label-text" for="<%=id%>">
            <span class="dd-choose-item-unit-name"><%=name%></span>
            <span class="dd-choose-item-count"> (<%=count%>)</span>
        </label>
    </span>
</script><script type="text/template" id="list-item-template">
