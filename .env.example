# Подключение к Supabase. Оба значения публичные: они и так уходят в браузер
# вместе со сборкой. Служебному ключу (service_role) здесь не место — он живёт
# только в секретах проекта Supabase.
VITE_SUPABASE_URL=https://ваш-проект.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=публикуемый-ключ-проекта

# Адрес сборки. По умолчанию сайт публикуется на GitHub Pages по подпути
# /seomagic-saas-tool/. Для своего домена поставьте "/".
# VITE_BASE_PATH=/
